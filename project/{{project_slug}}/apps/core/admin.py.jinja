"""Admin configuration for the core application."""

from django.contrib import admin
from unfold.admin import ModelAdmin
from unfold.contrib.filters.admin import ChoicesDropdownFilter

from .models import WorkItem


@admin.register(WorkItem)
class WorkItemAdmin(ModelAdmin):
    """Configure the WorkItem admin interface."""

    list_display = ('code', 'title', 'status', 'priority', 'owner', 'due_date', 'updated_at')
    list_filter = (
        ('status', ChoicesDropdownFilter),
        ('priority', ChoicesDropdownFilter),
        'due_date',
        'updated_at',
    )
    search_fields = ('code', 'title', 'description', 'owner__username', 'owner__email')
    autocomplete_fields = ('owner',)
    readonly_fields = ('created_at', 'updated_at')
    list_select_related = ('owner',)
    fieldsets = (
        ('Record', {'fields': ('code', 'title', 'description')}),
        ('Workflow', {'fields': ('status', 'priority', 'owner', 'due_date')}),
        ('Audit', {'fields': ('created_at', 'updated_at'), 'classes': ('collapse',)}),
    )
