"""Core application models."""

from typing import ClassVar

from django.conf import settings
from django.db import models


class WorkItem(models.Model):
    """A unit of operational work tracked through the admin."""

    class Status(models.TextChoices):
        """Workflow states for a work item."""

        OPEN = 'open', 'Open'
        IN_PROGRESS = 'in_progress', 'In progress'
        BLOCKED = 'blocked', 'Blocked'
        DONE = 'done', 'Done'

    class Priority(models.TextChoices):
        """Available work item priorities."""

        LOW = 'low', 'Low'
        MEDIUM = 'medium', 'Medium'
        HIGH = 'high', 'High'

    code = models.CharField(max_length=24, unique=True)
    title = models.CharField(max_length=160)
    description = models.TextField(blank=True)
    status = models.CharField(max_length=20, choices=Status, default=Status.OPEN)
    priority = models.CharField(max_length=20, choices=Priority, default=Priority.MEDIUM)
    owner = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name='work_items',
    )
    due_date = models.DateField(null=True, blank=True)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        """Model metadata."""

        ordering: ClassVar[list[str]] = ['-updated_at']

    def __str__(self) -> str:
        """Return the human-readable work item label."""
        return f'{self.code} - {self.title}'
