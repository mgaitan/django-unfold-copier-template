"""Seed the database with demonstration data."""

from datetime import timedelta

from django.contrib.auth import get_user_model
from django.core.management.base import BaseCommand
from django.utils import timezone

from {{ project_slug }}.apps.core.models import WorkItem


class Command(BaseCommand):
    """Create the demo administrator and work items."""

    help = 'Seed demo admin and work items'

    def handle(self, *args: object, **options: object) -> None:
        """Create demonstration records when they do not exist."""
        user_model = get_user_model()
        user, created = user_model.objects.get_or_create(
            username='admin',
            defaults={'email': 'admin@example.com', 'is_staff': True, 'is_superuser': True},
        )
        if created:
            user.set_password('admin123')
            user.save()
            self.stdout.write(self.style.SUCCESS('Created admin user: admin / admin123'))
        else:
            self.stdout.write('Admin user already exists')

        demo_items = [
            {
                'code': 'OPS-1001',
                'title': 'Review supplier onboarding flow',
                'description': 'Validate required fields, approval steps, and default permissions.',
                'status': WorkItem.Status.IN_PROGRESS,
                'priority': WorkItem.Priority.HIGH,
                'due_date': timezone.localdate() + timedelta(days=4),
            },
            {
                'code': 'OPS-1002',
                'title': 'Prepare monthly compliance export',
                'description': 'Generate the export and reconcile missing owners.',
                'status': WorkItem.Status.OPEN,
                'priority': WorkItem.Priority.MEDIUM,
                'due_date': timezone.localdate() + timedelta(days=9),
            },
            {
                'code': 'OPS-1003',
                'title': 'Resolve blocked invoice approval',
                'description': 'Check approval chain and document the resolution path.',
                'status': WorkItem.Status.BLOCKED,
                'priority': WorkItem.Priority.HIGH,
                'due_date': timezone.localdate() + timedelta(days=2),
            },
        ]

        for item_data in demo_items:
            item, created = WorkItem.objects.get_or_create(
                code=item_data['code'],
                defaults={**item_data, 'owner': user},
            )
            status = 'created' if created else 'already exists'
            self.stdout.write(self.style.SUCCESS(f'Work item {item.code} {status}'))
